# Primary host
HOST=10.0.0.1
PORT=22
USER_NAME=username
PASSWORD=password
SUDO_PASSWORD=secondpassword
PRIV_KEY_PATH=~/.ssh/id_rsa
PASS_PHRASE=passphrase

# Secondary user for the sudo/su live test
secondaryUser=seconduser
secondUserPassword=secondpassword

# Nested and tunnelled hosts
SERVER2_HOST=10.0.0.2
SERVER2_PORT=22
SERVER2_USER_NAME=username
SERVER2_PASSWORD=password

SERVER3_HOST=10.0.0.3
SERVER3_PORT=22
SERVER3_USER_NAME=username
SERVER3_PASSWORD=password

# Multi-host README example
SERVER1_HOST=10.0.0.1
SERVER1_PORT=22
SERVER1_USER_NAME=username
SERVER1_PASSWORD=password
SERVER1_PASS_PHRASE=passphrase
SERVER1_PRIV_KEY_PATH=~/.ssh/id_rsa

# Live-test output
DEBUG=false
VERBOSE=false

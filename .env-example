# Primary host
HOST=10.0.0.1
PORT=22
USER_NAME=username
PASSWORD=password

# Private key authentication (test/private_key.js)
PRIVATE_KEY_PATH=~/.ssh/id_rsa
KEY_PASSPHRASE=passphrase

# Host fingerprint verification (test/fingerprint.js)
# Leave empty to print the hash and accept the first connection, then pin it.
EXPECTED_HOST_HASH=

# Secondary user for the sudo/su live test
SECOND_USER=seconduser
SECOND_USER_PASSWORD=secondpassword

# Nested, tunnelled, and chained hosts
SERVER2_HOST=10.0.0.2
SERVER2_PORT=22
SERVER2_USER_NAME=username
SERVER2_PASSWORD=password

SERVER3_HOST=10.0.0.3
SERVER3_PORT=22
SERVER3_USER_NAME=username
SERVER3_PASSWORD=password

# Multiple primary hosts (test/multiple_primary_hosts.js)
SERVER1_HOST=10.0.0.1
SERVER1_PORT=22
SERVER1_USER_NAME=username
SERVER1_PASSWORD=password

# Live-test output
DEBUG=false
VERBOSE=false

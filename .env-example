# Primary host (server1)
HOST=192.168.44.10
PORT=22
USER_NAME=tester
PASSWORD=password

# Private key authentication (test/live/private_key.js) and hop auth
PRIVATE_KEY_PATH=test/certs/test_ed25519
KEY_PASSPHRASE=

# Path to the private key as it exists on the jump host(s), used by nested
# `ssh -i` hops. Override these when the key is installed elsewhere or under a
# different name. They must be absolute paths on the jump host.
HOP_KEY_PATH=/home/tester/.ssh/id_ed25519
HOP2_KEY_PATH=/home/tester/.ssh/id_ed25519

# Host fingerprint verification (test/live/fingerprint.js)
# Leave empty to print the hash and accept the first connection, then pin it.
EXPECTED_HOST_HASH=

# Secondary user for the sudo/su live test
SECOND_USER=suuser
SECOND_USER_PASSWORD=secondpassword

# Keyboard-interactive test user on server1 (password auth disabled for this user)
KBD_USER=kbduser
KBD_PASSWORD=kbdpassword
KBD_HOST=192.168.44.10
KBD_PORT=22

# NOPASSWD sudo test user (must have NOPASSWD sudo on SERVER2_HOST)
NOPASSWD_USER=nopasswd
NOPASSWD_PASSWORD=nopasswdpassword

# Nested, tunnelled, and chained hosts
# The test key authenticates these hosts. The *_PASSWORD values are only
# needed if you switch a test back to password authentication.
SERVER2_HOST=192.168.44.11
SERVER2_PORT=22
SERVER2_USER_NAME=tester
SERVER2_PASSWORD=password

SERVER3_HOST=192.168.44.12
SERVER3_PORT=22
SERVER3_USER_NAME=tester
SERVER3_PASSWORD=password

# Multiple primary hosts (test/live/multiple_primary_hosts.js)
SERVER1_HOST=192.168.44.10
SERVER1_PORT=22
SERVER1_USER_NAME=tester
SERVER1_PASSWORD=password

# Live-test output
DEBUG=false
VERBOSE=false

# Live-test VM provisioning (test/provision/provision.js)
# Per-server addresses, bootstrap users, and role settings live in
# test/provision/.env (copy test/provision/.env.example). The PROVISION_*
# variables here are generic fallbacks and are usually left unset.
PROVISION_ROLE=server1

# Key files installed on the VM. Defaults point at test/certs.
TEST_PRIVATE_KEY_PATH=test/certs/test_ed25519
TEST_PUBLIC_KEY_PATH=
ADMIN_PUBLIC_KEY_PATH=test/certs/admin_ed25519.pub

# Sets the password for the bootstrap/admin account (ssh2shell) during
# provisioning. Leave empty to keep the existing password; a freshly created
# ssh2shell then has the admin key only.
SSH2SHELL_PASSWORD=

# Provisioning configuration for test/provision/provision.js.
#
# Copy this file to test/provision/.env and edit it there. The .env file is
# gitignored; this example is committed.
#
# Values are read in this order:
#   1. the shell environment
#   2. PROVISION_<ROLE>_* from test/provision/.env
#   3. PROVISION_* from test/provision/.env or the repository .env
#   4. built-in defaults
#
# The role is the first CLI argument, then PROVISION_ROLE, then server1.
# PROVISION_ROLE=server1

# server1
#
# HOST is the address the VM is reachable at now. Leave it empty to use the
# static IP; set it to the DHCP address for a fresh install. On a fresh VM,
# switch Adapter 1 to host-only first, then read the address with
# `ip -br addr` on the VM console. See README.md ("Quick start").
# USER must be a bootstrap account that can run sudo. A fresh Ubuntu install
# usually has an "ubuntu" account.
# KEY_PATH=none forces password authentication instead of the test key.
#
# PROVISION_SERVER1_HOST=
# PROVISION_SERVER1_PORT=22
# PROVISION_SERVER1_IP=192.168.44.10
# PROVISION_SERVER1_HOSTNAME=server1
# PROVISION_SERVER1_INTERFACE=enp0s3
# PROVISION_SERVER1_USER=ubuntu
# PROVISION_SERVER1_PASSWORD=
# PROVISION_SERVER1_SUDO_PASSWORD=
# PROVISION_SERVER1_KEY_PATH=none
# PROVISION_SERVER1_APPLY_NETWORK=true
# PROVISION_SERVER1_REGENERATE_MACHINE_ID=false
# PROVISION_SERVER1_IDLE_TIMEOUT=20000

# server2
#
# PROVISION_SERVER2_HOST=
# PROVISION_SERVER2_PORT=22
# PROVISION_SERVER2_IP=192.168.44.11
# PROVISION_SERVER2_HOSTNAME=server2
# PROVISION_SERVER2_INTERFACE=enp0s3
# PROVISION_SERVER2_USER=ubuntu
# PROVISION_SERVER2_PASSWORD=
# PROVISION_SERVER2_SUDO_PASSWORD=
# PROVISION_SERVER2_KEY_PATH=none
# PROVISION_SERVER2_APPLY_NETWORK=true
# PROVISION_SERVER2_REGENERATE_MACHINE_ID=false
# PROVISION_SERVER2_IDLE_TIMEOUT=20000

# server3
#
# PROVISION_SERVER3_HOST=
# PROVISION_SERVER3_PORT=22
# PROVISION_SERVER3_IP=192.168.44.12
# PROVISION_SERVER3_HOSTNAME=server3
# PROVISION_SERVER3_INTERFACE=enp0s3
# PROVISION_SERVER3_USER=ubuntu
# PROVISION_SERVER3_PASSWORD=
# PROVISION_SERVER3_SUDO_PASSWORD=
# PROVISION_SERVER3_KEY_PATH=none
# PROVISION_SERVER3_APPLY_NETWORK=true
# PROVISION_SERVER3_REGENERATE_MACHINE_ID=false
# PROVISION_SERVER3_IDLE_TIMEOUT=20000

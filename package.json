{
  "name": "ssh2shell",
  "version": "2.0.14",
  "author": "cmp-202",
  "description": "A wrapper class for ssh2 to run multiple sequential commands in an SSH shell session, handle command responses, and tunnel through to other hosts using nested host objects",
  "main": "./lib/ssh2shell.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ssh2": "^1.4.0"
  },
  "devDependencies": {
    "dotenv": "^8.6.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check:build": "node scripts/check-build.js",
    "test": "npm run check:build && npm run test:unit && npm run test:baseline",
    "test:unit": "node --test test/unit",
    "test:baseline": "node scripts/run-tests.js"
  },
  "keywords": [
    "SSH",
    "ssh2",
    "shell",
    "server",
    "client",
    "multiple",
    "command",
    "commands",
    "tunnel",
    "deploy",
    "host",
    "hosts",
    "automation",
    "fingerprint",
    "validation",
    "hash",
    "cipher",
    "persistent",
    "sequential",
    "console",
    "sudo",
    "su",
    "prompt",
    "session",
    "connection"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/cmp-202/ssh2shell.git"
  },
  "bugs": {
    "url": "https://github.com/cmp-202/ssh2shell/issues"
  },
  "homepage": "https://github.com/cmp-202/ssh2shell/wiki",
  "directories": {
    "test": "test"
  },
  "license": "ISC"
}
